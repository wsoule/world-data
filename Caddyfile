# Serves the prerendered site (apps/web/dist/client, copied to /srv) in the
# Docker image built from the root Dockerfile. TLS is terminated in front of
# Caddy (Railway's edge), so Caddy speaks plain HTTP on $PORT.
{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:8080} {
	root * /srv

	# Canonical URLs have no trailing slash: /topics/x/ -> /topics/x. Only
	# paths made of URL-safe characters redirect, so a backslash, tab or
	# encoded "?" can never turn the Location into another host ("/\evil.com").
	@trailing path_regexp trailing ^(/[A-Za-z0-9._~-][A-Za-z0-9._~/-]*?)/+$
	redir @trailing {re.trailing.1}{?query} 308

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Content-Security-Policy "frame-ancestors 'self'"
		# Browsers only honour this over HTTPS, which Railway's edge provides.
		Strict-Transport-Security "max-age=31536000"
		# Pages revalidate on every visit; set only where nothing below did.
		?Cache-Control "public, max-age=0, must-revalidate"
	}
	# Hashed bundles never change.
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	# Dataset files keep their names across deploys, so cache them briefly.
	header /data/* Cache-Control "public, max-age=300"
	header /site.webmanifest Content-Type application/manifest+json

	# /topics/x is served from /topics/x/index.html without a redirect.
	try_files {path} {path}/index.html
	encode zstd gzip
	file_server {
		precompressed gzip
	}

	# Unknown paths get the prerendered "Page not found" page with a 404
	# status. Conditional and range headers are dropped so a 404 is always
	# the whole page, never a 304 or a 206 slice of 404.html.
	handle_errors 404 {
		request_header -If-None-Match
		request_header -If-Modified-Since
		request_header -If-Match
		request_header -If-Unmodified-Since
		request_header -If-Range
		request_header -Range
		header Cache-Control "no-cache"
		rewrite * /404.html
		file_server {
			precompressed gzip
		}
	}
}
